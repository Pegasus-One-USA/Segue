{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.45.15.27210",
      "templateHash": "3082100763136240721"
    }
  },
  "parameters": {
    "namePrefix": {
      "type": "string",
      "defaultValue": "fhirbridge",
      "metadata": {
        "description": "Short name used to build every resource name in this deployment."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for every resource. Defaults to the resource group's own region."
      }
    },
    "sqlSaPassword": {
      "type": "securestring",
      "metadata": {
        "description": "SQL Server SA password. Must satisfy SQL Server's complexity policy."
      }
    },
    "jwtSigningKey": {
      "type": "securestring",
      "minLength": 32,
      "metadata": {
        "description": "FHIRBridge.Api's Authentication:SigningKey (HS256). At least 32 random characters."
      }
    },
    "imageRegistryServer": {
      "type": "string",
      "metadata": {
        "description": "Registry the 3 custom images were published to (e.g. myregistry.azurecr.io, or ghcr.io/your-org for a public GHCR package)."
      }
    },
    "imageTag": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": {
        "description": "Tag the 3 custom images were published under."
      }
    },
    "imageRegistryUsername": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Registry username. Leave blank if the registry allows anonymous/public pull (e.g. a public GHCR package) — no registry credentials are configured in that case."
      }
    },
    "imageRegistryPassword": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Registry password/token. Leave blank alongside imageRegistryUsername for anonymous/public pull."
      }
    },
    "sqlPort": {
      "type": "int",
      "defaultValue": 1433,
      "metadata": {
        "description": "Port SQL Server Express listens on (internal-only — reached only by the other Container Apps in this environment, never externally). Passed to the container as MSSQL_TCP_PORT since ingress targetPort alone does not change what SQL Server itself listens on."
      }
    },
    "redisPort": {
      "type": "int",
      "defaultValue": 6379,
      "metadata": {
        "description": "Port Redis listens on (internal-only). Passed to the container via a redis-server --port override, since Redis has no env-var port setting."
      }
    },
    "redisPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Password Redis requires (--requirepass) — defense-in-depth on top of network isolation. Passed as a plain container command argument (Redis has no env-var equivalent and Container Apps command arguments have no secretRef option), so it is visible to anyone with read access to this Container App's configuration — same exposure level as any other command argument."
      }
    },
    "hapiTerminologyPostgresPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Password for the hapi_terminology Postgres role backing the HAPI terminology server's own schema (internal-only — not the app's own FHIRBridgeDb)."
      }
    },
    "hapiTerminologyExternalAccess": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Exposes the HAPI terminology server externally (Container Apps external ingress) so it can be reached directly from outside this environment — e.g. a separate terminology admin tool, or a third-party integration — rather than only internally by fhirbridge-app/worker. Defaults to false (internal-only, like sqlserver/redis). Setting hapiTerminologyCustomDomain also forces this on, since Azure Container Apps custom domains require external ingress."
      }
    },
    "hapiTerminologyCustomDomain": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Custom domain for the HAPI terminology server (e.g. terminology.customer.com). Leave blank to use the auto-generated *.azurecontainerapps.io URL once hapiTerminologyExternalAccess is true. Same three-deploy flow as fhirbridgeAppCustomDomain (including the required first deploy with this left blank) — see the hapiTerminologyDomainVerificationId output."
      }
    },
    "fhirbridgeAppCustomDomain": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Custom domain for the FHIRBridge app (e.g. app.customer.com). Leave blank to keep the auto-generated *.azurecontainerapps.io URL. REQUIRED three-deploy flow, not two, to avoid InvalidCustomHostNameValidation/RequireCustomHostnameInEnvironment: (0) first deploy with this LEFT BLANK, so the app is actually created — Azure only assigns its customDomainVerificationId once the app exists, and there is no way to know that ID in advance, so setting a domain on the very first-ever deploy of a given namePrefix always fails with \"a TXT record ... was not found\"; (1) once deployed, read fhirbridgeAppDomainVerificationId, create CNAME (domain -> fhirbridgeAppUrl hostname) + TXT asuid.<domain> = that id, wait for DNS, THEN redeploy with this domain set and bindCustomDomainCertificates=false — registers the hostname (bindingType Disabled, no cert yet); (2) redeploy again with the SAME domain and bindCustomDomainCertificates=true — creates the managed certificate (hostname already exists) then binds SniEnabled SSL."
      }
    },
    "demoAppCustomDomain": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Custom domain for the Demo app. Same three-deploy flow as fhirbridgeAppCustomDomain (including the required first deploy with this left blank) — see the demoAppDomainVerificationId output."
      }
    },
    "bindCustomDomainCertificates": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Phase-2 flag. false (default) = register custom hostnames only (bindingType Disabled), do NOT create managed certificates. true = create managed certificates and bind SniEnabled SSL. Only set true AFTER hostnames were registered in a prior deploy AND DNS CNAME + asuid TXT have propagated. Setting true on first deploy with a new domain causes RequireCustomHostnameInEnvironment."
      }
    },
    "sqlServerSize": {
      "type": "string",
      "defaultValue": "Large",
      "allowedValues": [
        "Small",
        "Medium",
        "Large",
        "XLarge"
      ],
      "metadata": {
        "description": "SQL Server container size."
      }
    },
    "redisSize": {
      "type": "string",
      "defaultValue": "Medium",
      "allowedValues": [
        "Small",
        "Medium",
        "Large",
        "XLarge"
      ],
      "metadata": {
        "description": "Redis container size."
      }
    },
    "fhirbridgeAppSize": {
      "type": "string",
      "defaultValue": "Medium",
      "allowedValues": [
        "Small",
        "Medium",
        "Large",
        "XLarge"
      ],
      "metadata": {
        "description": "FHIRBridge app (Api + Gateway) container size."
      }
    },
    "demoAppSize": {
      "type": "string",
      "defaultValue": "Small",
      "allowedValues": [
        "Small",
        "Medium",
        "Large",
        "XLarge"
      ],
      "metadata": {
        "description": "Demo app container size."
      }
    },
    "workerSize": {
      "type": "string",
      "defaultValue": "Small",
      "allowedValues": [
        "Small",
        "Medium",
        "Large",
        "XLarge"
      ],
      "metadata": {
        "description": "Worker container size."
      }
    },
    "hapiTerminologySize": {
      "type": "string",
      "defaultValue": "Large",
      "allowedValues": [
        "Small",
        "Medium",
        "Large",
        "XLarge"
      ],
      "metadata": {
        "description": "HAPI terminology server container size."
      }
    },
    "hapiTerminologyPostgresSize": {
      "type": "string",
      "defaultValue": "Medium",
      "allowedValues": [
        "Small",
        "Medium",
        "Large",
        "XLarge"
      ],
      "metadata": {
        "description": "HAPI terminology server Postgres container size."
      }
    }
  },
  "variables": {
    "containerSizes": {
      "Small": {
        "cpu": "[json('0.25')]",
        "memory": "0.5Gi"
      },
      "Medium": {
        "cpu": "[json('0.5')]",
        "memory": "1Gi"
      },
      "Large": {
        "cpu": "[json('1.0')]",
        "memory": "2Gi"
      },
      "XLarge": {
        "cpu": "[json('2.0')]",
        "memory": "4Gi"
      }
    },
    "commonTags": {
      "Project": "FHIRBridge",
      "Component": "containerization",
      "Environment": "[parameters('namePrefix')]",
      "ManagedBy": "Bicep"
    },
    "uniqueSuffix": "[uniqueString(resourceGroup().id, parameters('namePrefix'))]",
    "storageAccountName": "[toLower(format('{0}st{1}', parameters('namePrefix'), variables('uniqueSuffix')))]",
    "sqlServerName": "[format('{0}-sqlserver', parameters('namePrefix'))]",
    "redisName": "[format('{0}-redis', parameters('namePrefix'))]",
    "hapiTerminologyPostgresName": "[format('{0}-term-db', parameters('namePrefix'))]",
    "hapiTerminologyName": "[format('{0}-term', parameters('namePrefix'))]",
    "fhirbridgeAppName": "[format('{0}-app', parameters('namePrefix'))]",
    "demoAppName": "[format('{0}-demo-app', parameters('namePrefix'))]",
    "workerName": "[format('{0}-worker', parameters('namePrefix'))]",
    "hasRegistryCreds": "[not(empty(parameters('imageRegistryUsername')))]",
    "registryConfig": "[if(variables('hasRegistryCreds'), createArray(createObject('server', parameters('imageRegistryServer'), 'username', parameters('imageRegistryUsername'), 'passwordSecretRef', 'registry-password')), createArray())]",
    "registrySecret": "[if(variables('hasRegistryCreds'), createArray(createObject('name', 'registry-password', 'value', parameters('imageRegistryPassword'))), createArray())]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}-logs', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-env', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('namePrefix'))), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('namePrefix'))), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('namePrefix')))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2"
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices/shares",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/default/sql-data', variables('storageAccountName'))]",
      "properties": {
        "shareQuota": 50
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices/shares",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/default/redis-data', variables('storageAccountName'))]",
      "properties": {
        "shareQuota": 10
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices/shares",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/default/keys-data', variables('storageAccountName'))]",
      "properties": {
        "shareQuota": 1
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices/shares",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/default/hapi-terminology-data', variables('storageAccountName'))]",
      "properties": {
        "shareQuota": 10
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments/storages",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/{1}', format('{0}-env', parameters('namePrefix')), 'sql-data')]",
      "properties": {
        "azureFile": {
          "accountName": "[variables('storageAccountName')]",
          "accountKey": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-01-01').keys[0].value]",
          "shareName": "sql-data",
          "accessMode": "ReadWrite"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices/shares', split(format('{0}/default/sql-data', variables('storageAccountName')), '/')[0], split(format('{0}/default/sql-data', variables('storageAccountName')), '/')[1], split(format('{0}/default/sql-data', variables('storageAccountName')), '/')[2])]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments/storages",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/{1}', format('{0}-env', parameters('namePrefix')), 'redis-data')]",
      "properties": {
        "azureFile": {
          "accountName": "[variables('storageAccountName')]",
          "accountKey": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-01-01').keys[0].value]",
          "shareName": "redis-data",
          "accessMode": "ReadWrite"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices/shares', split(format('{0}/default/redis-data', variables('storageAccountName')), '/')[0], split(format('{0}/default/redis-data', variables('storageAccountName')), '/')[1], split(format('{0}/default/redis-data', variables('storageAccountName')), '/')[2])]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments/storages",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/{1}', format('{0}-env', parameters('namePrefix')), 'keys-data')]",
      "properties": {
        "azureFile": {
          "accountName": "[variables('storageAccountName')]",
          "accountKey": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-01-01').keys[0].value]",
          "shareName": "keys-data",
          "accessMode": "ReadWrite"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices/shares', split(format('{0}/default/keys-data', variables('storageAccountName')), '/')[0], split(format('{0}/default/keys-data', variables('storageAccountName')), '/')[1], split(format('{0}/default/keys-data', variables('storageAccountName')), '/')[2])]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments/storages",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/{1}', format('{0}-env', parameters('namePrefix')), 'hapi-terminology-data')]",
      "properties": {
        "azureFile": {
          "accountName": "[variables('storageAccountName')]",
          "accountKey": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-01-01').keys[0].value]",
          "shareName": "hapi-terminology-data",
          "accessMode": "ReadWrite"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices/shares', split(format('{0}/default/hapi-terminology-data', variables('storageAccountName')), '/')[0], split(format('{0}/default/hapi-terminology-data', variables('storageAccountName')), '/')[1], split(format('{0}/default/hapi-terminology-data', variables('storageAccountName')), '/')[2])]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('sqlServerName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "configuration": {
          "secrets": [
            {
              "name": "sql-sa-password",
              "value": "[parameters('sqlSaPassword')]"
            }
          ],
          "ingress": {
            "external": false,
            "targetPort": "[parameters('sqlPort')]",
            "transport": "tcp"
          }
        },
        "template": {
          "containers": [
            {
              "name": "sqlserver",
              "image": "mcr.microsoft.com/mssql/server:2022-latest",
              "resources": "[variables('containerSizes')[parameters('sqlServerSize')]]",
              "env": [
                {
                  "name": "ACCEPT_EULA",
                  "value": "Y"
                },
                {
                  "name": "MSSQL_PID",
                  "value": "Express"
                },
                {
                  "name": "MSSQL_SA_PASSWORD",
                  "secretRef": "sql-sa-password"
                },
                {
                  "name": "MSSQL_TCP_PORT",
                  "value": "[string(parameters('sqlPort'))]"
                }
              ],
              "volumeMounts": [
                {
                  "volumeName": "sql-data",
                  "mountPath": "/var/opt/mssql"
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "sql-data",
              "storageType": "AzureFile",
              "storageName": "sql-data"
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "[resourceId('Microsoft.App/managedEnvironments/storages', format('{0}-env', parameters('namePrefix')), 'sql-data')]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('redisName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "configuration": {
          "ingress": {
            "external": false,
            "targetPort": "[parameters('redisPort')]",
            "transport": "tcp"
          }
        },
        "template": {
          "containers": [
            {
              "name": "redis",
              "image": "redis:7-alpine",
              "resources": "[variables('containerSizes')[parameters('redisSize')]]",
              "command": [
                "redis-server",
                "--port",
                "[string(parameters('redisPort'))]",
                "--requirepass",
                "[parameters('redisPassword')]"
              ],
              "volumeMounts": [
                {
                  "volumeName": "redis-data",
                  "mountPath": "/data"
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "redis-data",
              "storageType": "AzureFile",
              "storageName": "redis-data"
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "[resourceId('Microsoft.App/managedEnvironments/storages', format('{0}-env', parameters('namePrefix')), 'redis-data')]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('hapiTerminologyPostgresName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "configuration": {
          "secrets": [
            {
              "name": "hapi-terminology-postgres-password",
              "value": "[parameters('hapiTerminologyPostgresPassword')]"
            }
          ],
          "ingress": {
            "external": false,
            "targetPort": 5432,
            "transport": "tcp"
          }
        },
        "template": {
          "containers": [
            {
              "name": "hapi-terminology-postgres",
              "image": "postgres:16-alpine",
              "resources": "[variables('containerSizes')[parameters('hapiTerminologyPostgresSize')]]",
              "env": [
                {
                  "name": "POSTGRES_DB",
                  "value": "hapi_terminology"
                },
                {
                  "name": "POSTGRES_USER",
                  "value": "hapi_terminology"
                },
                {
                  "name": "POSTGRES_PASSWORD",
                  "secretRef": "hapi-terminology-postgres-password"
                },
                {
                  "name": "PGDATA",
                  "value": "/var/lib/postgresql/data/pgdata"
                }
              ],
              "volumeMounts": [
                {
                  "volumeName": "hapi-terminology-data",
                  "mountPath": "/var/lib/postgresql/data"
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "hapi-terminology-data",
              "storageType": "AzureFile",
              "storageName": "hapi-terminology-data"
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "[resourceId('Microsoft.App/managedEnvironments/storages', format('{0}-env', parameters('namePrefix')), 'hapi-terminology-data')]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('hapiTerminologyName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "configuration": {
          "secrets": [
            {
              "name": "hapi-terminology-postgres-password",
              "value": "[parameters('hapiTerminologyPostgresPassword')]"
            }
          ],
          "ingress": {
            "external": "[or(parameters('hapiTerminologyExternalAccess'), not(empty(parameters('hapiTerminologyCustomDomain'))))]",
            "targetPort": 8080,
            "transport": "auto",
            "customDomains": "[if(not(empty(parameters('hapiTerminologyCustomDomain'))), createArray(if(parameters('bindCustomDomainCertificates'), createObject('name', parameters('hapiTerminologyCustomDomain'), 'certificateId', resourceId('Microsoft.App/managedEnvironments/managedCertificates', format('{0}-env', parameters('namePrefix')), format('{0}-cert', variables('hapiTerminologyName'))), 'bindingType', 'SniEnabled'), createObject('name', parameters('hapiTerminologyCustomDomain'), 'bindingType', 'Disabled'))), createArray())]"
          }
        },
        "template": {
          "containers": [
            {
              "name": "hapi-terminology",
              "image": "hapiproject/hapi:latest",
              "resources": "[variables('containerSizes')[parameters('hapiTerminologySize')]]",
              "env": [
                {
                  "name": "SPRING_DATASOURCE_URL",
                  "value": "[format('jdbc:postgresql://{0}:5432/hapi_terminology', variables('hapiTerminologyPostgresName'))]"
                },
                {
                  "name": "SPRING_DATASOURCE_USERNAME",
                  "value": "hapi_terminology"
                },
                {
                  "name": "SPRING_DATASOURCE_PASSWORD",
                  "secretRef": "hapi-terminology-postgres-password"
                },
                {
                  "name": "SPRING_DATASOURCE_DRIVERCLASSNAME",
                  "value": "org.postgresql.Driver"
                },
                {
                  "name": "SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT",
                  "value": "ca.uhn.fhir.jpa.model.dialect.HapiFhirPostgres94Dialect"
                },
                {
                  "name": "HAPI_FHIR_VERSION",
                  "value": "R4"
                }
