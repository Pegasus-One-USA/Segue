              }
            }
          },
          "variables": {
            "thisCustomDomain": "[if(parameters('bindCertificate'), createObject('name', parameters('domain'), 'certificateId', resourceId('Microsoft.App/managedEnvironments/managedCertificates', parameters('environmentName'), format('{0}-{1}-cert', parameters('appName'), replace(parameters('domain'), '.', '-'))), 'bindingType', 'SniEnabled'), createObject('name', parameters('domain'), 'bindingType', 'Disabled'))]"
          },
          "resources": [
            {
              "condition": "[parameters('bindCertificate')]",
              "type": "Microsoft.App/managedEnvironments/managedCertificates",
              "apiVersion": "2024-03-01",
              "name": "[format('{0}/{1}', parameters('environmentName'), format('{0}-{1}-cert', parameters('appName'), replace(parameters('domain'), '.', '-')))]",
              "location": "[parameters('location')]",
              "properties": {
                "subjectName": "[parameters('domain')]",
                "domainControlValidation": "CNAME"
              }
            },
            {
