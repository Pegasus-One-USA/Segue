  "outputs": {
    "results": {
      "type": "array",
      "copy": {
        "count": "[length(variables('activeAppConfigs'))]",
        "input": {
          "app": "[variables('activeAppConfigs')[copyIndex()].key]",
          "appName": "[variables('activeAppConfigs')[copyIndex()].name]",
          "domain": "[variables('activeAppConfigs')[copyIndex()].domain]",
          "appFqdn": "[reference(resourceId('Microsoft.App/containerApps', variables('activeAppConfigs')[copyIndex()].name), '2024-03-01').configuration.ingress.fqdn]",
          "domainVerificationId": "[reference(resourceId('Microsoft.App/containerApps', variables('activeAppConfigs')[copyIndex()].name), '2024-03-01').customDomainVerificationId]",
          "customDomainUrl": "[format('https://{0}', variables('activeAppConfigs')[copyIndex()].domain)]"
        }
      }
    },
    "frontDoorCustomDomainValidationToken": {
      "type": "string",
      "metadata": {
        "description": "Populated only when enableFrontDoorWaf is true and segueAppDomain is set. A Front Door-specific validation token — different from segueAppDomainVerificationId's asuid.<domain> mechanism, which only applies to the Container-App-direct path. Add a TXT record at _dnsauth.<your domain> with this value; Azure auto-detects it and issues the managed certificate once found — no further deployment needed."
      },
      "value": "[if(and(parameters('enableFrontDoorWaf'), not(empty(parameters('segueAppDomain')))), reference(resourceId('Microsoft.Cdn/profiles/customDomains', variables('frontDoorProfileName'), replace(parameters('segueAppDomain'), '.', '-')), '2024-02-01').validationProperties.validationToken, '')]"
    },
    "frontDoorCustomDomainUrl": {
      "type": "string",
      "value": "[if(and(parameters('enableFrontDoorWaf'), not(empty(parameters('segueAppDomain')))), format('https://{0}', parameters('segueAppDomain')), '')]"
    }
  }
