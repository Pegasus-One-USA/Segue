                "configuration": "[union(parameters('baseConfiguration'), createObject('secrets', parameters('existingSecrets'), 'ingress', union(parameters('baseConfiguration').ingress, createObject('external', true(), 'customDomains', concat(parameters('otherCustomDomains'), createArray(variables('thisCustomDomain')))))))]",
                "template": "[parameters('containerTemplate')]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.App/managedEnvironments/managedCertificates', parameters('environmentName'), format('{0}-{1}-cert', parameters('appName'), replace(parameters('domain'), '.', '-')))]"
              ]
            }
          ]
        }
      },
      "dependsOn": [
        "registerHostnames"
      ]
    },
    {
      "condition": "[and(parameters('enableFrontDoorWaf'), not(empty(parameters('segueAppDomain'))))]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "frontdoor-route-waf-customdomain-update",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "profileName": {
            "value": "[variables('frontDoorProfileName')]"
          },
          "endpointName": {
            "value": "[variables('frontDoorEndpointName')]"
          },
          "routeName": {
            "value": "[variables('frontDoorRouteName')]"
          },
          "securityPolicyName": {
            "value": "[variables('frontDoorSecurityPolicyName')]"
          },
          "newCustomDomainId": {
            "value": "[resourceId('Microsoft.Cdn/profiles/customDomains', variables('frontDoorProfileName'), replace(parameters('segueAppDomain'), '.', '-'))]"
          },
          "existingRouteProperties": {
            "value": "[reference(resourceId('Microsoft.Cdn/profiles/afdEndpoints/routes', variables('frontDoorProfileName'), variables('frontDoorEndpointName'), variables('frontDoorRouteName')), '2024-02-01')]"
          },
          "existingSecurityPolicyParameters": {
            "value": "[reference(resourceId('Microsoft.Cdn/profiles/securityPolicies', variables('frontDoorProfileName'), variables('frontDoorSecurityPolicyName')), '2024-02-01').parameters]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.45.15.27210",
              "templateHash": "13830252167185128604"
            }
          },
          "parameters": {
            "profileName": {
              "type": "string",
              "metadata": {
                "description": "Front Door profile name."
              }
            },
            "endpointName": {
              "type": "string",
              "metadata": {
                "description": "Front Door endpoint name (parent of the route)."
              }
            },
            "routeName": {
              "type": "string",
              "metadata": {
                "description": "Name of the route to update - newCustomDomainId is appended to its customDomains array; everything else passes through unchanged."
              }
            },
            "securityPolicyName": {
              "type": "string",
              "metadata": {
                "description": "Name of the WAF security policy to update - newCustomDomainId is appended to its domain associations; everything else passes through unchanged."
              }
            },
            "newCustomDomainId": {
              "type": "string",
              "metadata": {
                "description": "Resource ID of the Front Door custom domain to associate with both the route (so traffic to it actually reaches the origin) and the WAF security policy (so the WAF actually applies to it, not just the default *.azurefd.net domain)."
              }
            },
            "existingRouteProperties": {
              "type": "object",
              "metadata": {
                "description": "The route's current properties, read by the caller via an `existing` reference."
              }
            },
            "existingSecurityPolicyParameters": {
              "type": "object",
              "metadata": {
                "description": "The security policy's current properties.parameters object, read by the caller via an `existing` reference."
              }
            }
          },
          "variables": {
            "otherRouteCustomDomains": "[filter(coalesce(tryGet(parameters('existingRouteProperties'), 'customDomains'), createArray()), lambda('cd', not(equals(lambdaVariables('cd').id, parameters('newCustomDomainId')))))]",
            "existingAssociation": "[parameters('existingSecurityPolicyParameters').associations[0]]",
            "otherAssociationDomains": "[filter(variables('existingAssociation').domains, lambda('d', not(equals(lambdaVariables('d').id, parameters('newCustomDomainId')))))]"
          },
          "resources": [
            {
              "type": "Microsoft.Cdn/profiles/afdEndpoints/routes",
              "apiVersion": "2024-02-01",
              "name": "[format('{0}/{1}/{2}', parameters('profileName'), parameters('endpointName'), parameters('routeName'))]",
              "properties": "[union(parameters('existingRouteProperties'), createObject('customDomains', concat(variables('otherRouteCustomDomains'), createArray(createObject('id', parameters('newCustomDomainId'))))))]"
            },
            {
              "type": "Microsoft.Cdn/profiles/securityPolicies",
              "apiVersion": "2024-02-01",
              "name": "[format('{0}/{1}', parameters('profileName'), parameters('securityPolicyName'))]",
              "properties": {
                "parameters": "[union(parameters('existingSecurityPolicyParameters'), createObject('associations', createArray(union(variables('existingAssociation'), createObject('domains', concat(variables('otherAssociationDomains'), createArray(createObject('id', parameters('newCustomDomainId')))))))))]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Cdn/profiles/afdEndpoints/routes', parameters('profileName'), parameters('endpointName'), parameters('routeName'))]"
              ]
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles/customDomains', variables('frontDoorProfileName'), replace(parameters('segueAppDomain'), '.', '-'))]"
      ]
