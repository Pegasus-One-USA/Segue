# Copy to terraform.tfvars (gitignored) and fill in real secrets before `terraform apply`.
# See ../../../README.md for the bootstrap order (ACR must exist and have images pushed before
# the Container Apps that reference them can be created).
#
# postgres_password / jwt_signing_key / redis_password are only SEED values for the containerized
# paths: the first apply writes them into the Key Vault this config creates (see the
# key_vault_name output), and every Container App reads the secret's value out of the Vault from
# then on, not these variables. Rotate a secret afterwards with `az keyvault secret set` (or the
# Portal) — a later `terraform apply` with the old value here will NOT overwrite it
# (lifecycle.ignore_changes on each azurerm_key_vault_secret). postgres_password is the one
# exception when use_azure_postgresql is true — see the Postgres block below.

name_prefix         = "segue"
resource_group_name = "rg-tusharpuri"   # must already exist: az group create --name rg-tusharpuri --location eastus
image_tag           = "v1"
jwt_signing_key = "replace-with-a-long-random-string-at-least-32-chars"

# Postgres (Segue's own database): false (default, or simply omit use_azure_postgresql) uses
# a containerized Postgres — postgres_password is REQUIRED in that mode, seeded into Key Vault.
# true instead creates a managed Azure Database for PostgreSQL Flexible Server (see
# azure_postgresql_sku/azure_postgresql_storage_mb in variables.tf) — postgres_password becomes
# that server's actual administrator_password directly (not seeded into Key Vault at all in this
# mode, since the server resource holds it), so still required either way, just used differently.
# use_azure_postgresql        = true
# azure_postgresql_sku        = "B_Standard_B1ms"
# azure_postgresql_storage_mb = 32768

postgres_password = "replace-with-a-strong-postgres-password"

# Redis: false (default, or simply omit use_azure_cache_for_redis) uses the containerized Redis
# below — redis_password and redis_trusted_certificate_thumbprint are both REQUIRED in that mode.
# true instead creates a managed Azure Cache for Redis (see azure_cache_sku/azure_cache_capacity in
# variables.tf) — both of those become unused, leave them blank or omit entirely.
# use_azure_cache_for_redis = true
# azure_cache_sku           = "Basic"
# azure_cache_capacity      = 0

redis_password = "replace-with-a-strong-redis-password"

# Run containerization/docker/redis-tls/generate-cert.ps1|sh once before building images -
# it prints this value. Only needed when use_azure_cache_for_redis is false (the default).
redis_trusted_certificate_thumbprint = "replace-with-the-thumbprint-generate-cert-printed"

# Optional — internal-only ports for Postgres / Redis (reached only by the other Container Apps in
# this environment, never externally; meaningless for whichever side is on its managed/PaaS option
# instead — Azure Database for PostgreSQL always uses 5432, Azure Cache uses its own ssl_port).
# Uncomment to override.
# postgres_port = 5432
# redis_port    = 6379

# Note: segue-app has no equivalent port variable — Azure Container Apps external HTTP
# ingress has no client-configurable port; it's always https://<app>.<domain> with no port number
# in the URL. See the AWS environment if a client-chosen public port is required.

# Custom domain — see variables.tf. Registers the hostname (no managed SSL cert yet —
# bind_custom_domain_certificates is currently a no-op; see its description in variables.tf).
# segue_app_custom_domain        = "app.customer.com"
# bind_custom_domain_certificates     = false

# Secret storage: false (default, or simply omit) keeps everything on the local DataProtection-
# encrypted DB table. true has this config create a dedicated, RBAC-enabled Key Vault for
# tenant/app-level secrets and wire up all the permissions the app needs to use it automatically —
# see enable_tenant_secrets_key_vault's description in variables.tf and
# Documents/KeyVault-Implementation.html for the full picture.
# enable_tenant_secrets_key_vault = true

# Centralized log viewing: false (default, or simply omit) — no Seq container. true creates a Seq
# container with its own public URL that Api/Gateway/Worker all send structured logs to — see
# enable_seq's description in variables.tf. seq_admin_password is required whenever this is true.
# enable_seq          = true
# seq_admin_password  = "change-me-strong-seq-password"

