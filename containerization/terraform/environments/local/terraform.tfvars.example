# Copy to terraform.tfvars (gitignored) and fill in real secrets before `terraform apply`.

image_tag         = "local"
postgres_password = "Ch4ngeMe!Str0ng"
jwt_signing_key   = "replace-with-a-long-random-string-at-least-32-chars"
redis_password    = "replace-with-a-strong-redis-password"

# Centralized log viewing: false (default, or simply omit) — no Seq container. true creates a Seq
# container that Api/Gateway/Worker all send structured logs to, browsable at
# http://localhost:<seq_host_port> — see enable_seq's description in variables.tf.
# enable_seq         = true
# seq_admin_password = "change-me-strong-seq-password"
