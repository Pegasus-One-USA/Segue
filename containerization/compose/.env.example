# Copy this file to .env (gitignored — see repo-root .gitignore's "Environment files" entry)
# and fill in real values before running `docker compose up`.

# --- Secrets ---
SQL_SA_PASSWORD=Ch4ngeMe!Str0ng
JWT_SIGNING_KEY=replace-with-a-long-random-string-at-least-32-chars
REDIS_PASSWORD=replace-with-a-strong-redis-password

# --- Angular build configuration (angular.json: production | staging | qa | dev | working) ---
PORTAL_BUILD_CONFIG=production
DEMO_BUILD_CONFIG=production

# --- Image tag (set by containerization/scripts/build-images.sh|ps1) ---
IMAGE_TAG=local

# --- ASP.NET Core environment name ---
ASPNETCORE_ENVIRONMENT=Production

# --- Host port overrides (defaults shown; change if they collide with the repo-root
#     docker-compose.yml's dev/E2E stack, which already uses 1433/6379) ---
APP_HOST_PORT=8080
DEMO_HOST_PORT=5500
SQL_HOST_PORT=1434
REDIS_HOST_PORT=6380
