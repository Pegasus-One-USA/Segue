{
  "name": "fhirbridge-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright end-to-end tests for the FHIRBridge portal.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium",
    "walkthrough": "playwright test --project=chromium walkthrough"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "dotenv": "^16.4.5"
  }
}
