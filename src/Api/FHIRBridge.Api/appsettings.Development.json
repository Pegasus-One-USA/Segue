{
  "ConnectionStrings": {
    "FHIRBridgeDb": "Server=localhost,1433;Database=FHIRBridge;User Id=sa;Password=Your_password123;TrustServerCertificate=True;Encrypt=True"
  },
  "Database": { "Provider": "SqlServer" },
  "ConnectionStrings1": {
    "FHIRBridgeDb1": "Host=localhost;Port=5434;Database=FHIRBridge;Username=postgres;Password=Your_password123;"
  },
  "Secrets": {
    "dev-local": {
      "sql-output-connection-string": "Server=localhost,1433;Database=FHIRBridge_Output;User Id=sa;Password=Your_password123;TrustServerCertificate=True;Encrypt=True",
      "epic-backend-private-key": "SET_VIA_DOTNET_USER_SECRETS"
    }
  },
  "Authentication": {
    "TokenLifetimeMinutes": 480,
    "RefreshTokenLifetimeDays": 30
  },
  "LocalAuth": {
    "ExposeResetTokens": true,
    "PasswordResetUrlTemplate": "http://localhost:4200/auth/reset-password?token={token}&email={email}",
    "AcceptInviteUrlTemplate": "http://localhost:5173/accept-invite?token={token}&email={email}",
    "MagicLinkUrlTemplate": "http://localhost:5173/auth/magic-link/redeem?token={token}&email={email}",
    "MagicLink": {
      "Enabled": true
    }
  },
  "WebhookIngestion": {
    "RequireSignature": false
  },
  "RateLimiting": {
    "OAuth": { "PermitPerWindow": 300, "WindowMinutes": 5 },
    "Auth": { "PermitPerWindow": 100, "WindowMinutes": 5 }
  },
  "FieldLineage": {
    "Enabled": true
  },
  "DataProtection": {
    "KeyRingPath": ""
  },
  "KeyVault": {
    "UseAzureKeyVault": true,
    "AllowConfigurationFallback": true,
    "VaultName": "fhirbridge-kv-test01",
    "HealthProbe": {
      "KeyVaultName": "fhirbridge-kv-test01",
      "SecretName": "fhirbridge-health-probe"
    }
  },
  "Portal": {
    "AllowedOrigins": [ "http://localhost:4200", "https://localhost:4200", "http://localhost:50261", "http://localhost:4300", "http://localhost:62453", "http://localhost:5501", "https://localhost:5500" ]
  },
  "Observability": {
    "SeqServerUrl": "http://localhost:5341",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "GeneratedFileDownload": {
    "RootPath": "App_Data/generated-file-downloads",
    "PublicBaseUrl": "http://localhost:5000"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
