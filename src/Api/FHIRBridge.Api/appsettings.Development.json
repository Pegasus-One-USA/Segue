{
  "ConnectionStrings": {
    "FHIRBridgeDb": "Server=localhost,1433;Database=FHIRBridge;User Id=sa;Password=Your_password123;TrustServerCertificate=True;Encrypt=True"
  },
  "Secrets": {
    "dev-local": {
      "sql-output-connection-string": "Server=localhost,1433;Database=FHIRBridge_Output;User Id=sa;Password=Your_password123;TrustServerCertificate=True;Encrypt=True",
      "epic-backend-private-key": "-----BEGIN PRIVATE KEY-----\\n-----END PRIVATE KEY-----\n"
    }
  },
  "Authentication": {
    "TokenLifetimeMinutes": 480,
    "RefreshTokenLifetimeDays": 30
  },
  "LocalAuth": {
    "ExposeResetTokens": true,
    "PasswordResetUrlTemplate": "http://localhost:5173/reset-password?token={token}&email={email}",
    "AcceptInviteUrlTemplate": "http://localhost:5173/accept-invite?token={token}&email={email}"
  },
  "WebhookIngestion": {
    "RequireSignature": false
  },
  "FieldLineage": {
    "Enabled": true
  },
  "DataProtection": {
    "KeyRingPath": ""
  },
  "Portal": {
    "AllowedOrigins": [ "http://localhost:4200", "https://localhost:4200", "http://localhost:50261", "http://localhost:4300", "http://localhost:62453", "http://localhost:5501" ]
  },
  "Observability": {
    "SeqServerUrl": "http://localhost:5341",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "GeneratedFileDownload": {
    "RootPath": "App_Data/generated-file-downloads",
    "PublicBaseUrl": "http://localhost:5000"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
