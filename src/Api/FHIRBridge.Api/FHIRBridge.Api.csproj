<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>044077df-af7f-484b-a9fc-ef5a02828198</UserSecretsId>
    <!-- Not IIS-hosted (Kestrel-only, run as a Windows Service/systemd unit) — suppress the
         auto-generated web.config, which would otherwise be unused dead weight in every publish. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.1" />
    <PackageReference Include="ITfoxtec.Identity.Saml2" Version="4.20.1" />
    <PackageReference Include="ITfoxtec.Identity.Saml2.MvcCore" Version="4.20.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.20" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.20">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
    <PackageReference Include="System.Threading.AccessControl" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Static legal content (e.g. Terms and Conditions) served directly from disk — replaceable at
         deploy time without a rebuild; see Program.cs's "/legal" static file mapping. -->
    <Content Include="Content\legal\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FHIRBridge.Application\FHIRBridge.Application.csproj" />
    <ProjectReference Include="..\..\FHIRBridge.Infrastructure\FHIRBridge.Infrastructure.csproj" />
    <ProjectReference Include="..\..\FHIRBridge.Domain\FHIRBridge.Domain.csproj" />
    <ProjectReference Include="..\..\Runtime\FHIRBridge.Runtime.Application\FHIRBridge.Runtime.Application.csproj" />
    <ProjectReference Include="..\..\Runtime\FHIRBridge.Runtime.Infrastructure\FHIRBridge.Runtime.Infrastructure.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\FHIRBridge.Observability\FHIRBridge.Observability.csproj" />
    <ProjectReference Include="..\..\FHIRBridge.Infrastructure.Migrations.PostgreSql\FHIRBridge.Infrastructure.Migrations.PostgreSql.csproj" />
  </ItemGroup>

</Project>
