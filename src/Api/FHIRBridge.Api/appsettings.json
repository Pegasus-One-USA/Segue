{
  "ConnectionStrings": {
    "FHIRBridgeDb": ""
  },
  "Authentication": {
    "SigningKey": "",
    "TokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 30,
    "Entra": {
      "Enabled": false,
      "Instance": "https://login.microsoftonline.com/",
      "TenantId": "",
      "ClientId": "",
      "Audience": "",
      "GroupRoleMappings": {}
    },
    "Google": {
      "Enabled": false,
      "ClientId": ""
    }
  },
  "LocalAuth": {
    "ExposeResetTokens": false,
    "PasswordResetUrlTemplate": "",
    "AcceptInviteUrlTemplate": ""
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@fhirbridge.local",
    "FromName": "FHIRBridge"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
