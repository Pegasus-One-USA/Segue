{
  "ConnectionStrings": {
    "FHIRBridgeDb": ""
  },
  "Authentication": {
    "TokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 30,
    "Entra": {
      "Enabled": false,
      "Instance": "https://login.microsoftonline.com/",
      "TenantId": "",
      "ClientId": "",
      "Audience": "",
      "GroupRoleMappings": {}
    },
    "Google": {
      "Enabled": false,
      "ClientId": ""
    },
    "Saml": {
      "Enabled": false,
      "ServiceProviderEntityId": "",
      "IdentityProviderEntityId": "",
      "SingleSignOnUrl": "",
      "IdentityProviderCertificate": "",
      "PortalRedirectUrl": "",
      "PortalErrorRedirectUrl": ""
    }
  },
  "LocalAuth": {
    "ExposeResetTokens": false,
    "PasswordResetUrlTemplate": "",
    "AcceptInviteUrlTemplate": "",
    "MagicLinkUrlTemplate": "",
    "MagicLink": {
      "Enabled": false
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "Auth": { "PermitPerWindow": 10, "WindowMinutes": 5 },
    "Webhook": { "PermitPerWindow": 120, "WindowMinutes": 1 }
  },
  "WebhookIngestion": {
    "Async": false,
    "RequireSignature": true,
    "SignatureHeader": "X-FHIRBridge-Signature",
    "SigningSecret": ""
  },
  "DataProtection": {
    "ApplicationName": "FHIRBridge",
    "KeyRingPath": ""
  },
  "KeyVault": {
    "UseAzureKeyVault": false,
    "AllowConfigurationFallback": true,
    "VaultName": "",
    "HealthProbe": {
      "KeyVaultName": "",
      "SecretName": ""
    }
  },
  "Mfa": {
    "Issuer": "FHIRBridge",
    "BackupCodeCount": 10
  },
  "FieldLineage": {
    "Enabled": false
  },
  "GeneratedFileDownload": {
    "RootPath": "App_Data/generated-file-downloads",
    "PublicBaseUrl": "http://172.184.140.105:6003"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "localhost"
}
