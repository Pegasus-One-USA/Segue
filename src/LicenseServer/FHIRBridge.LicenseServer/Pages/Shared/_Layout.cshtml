@using Microsoft.EntityFrameworkCore
@inject FHIRBridge.LicenseServer.Licensing.LicenseSigningKeyProvider KeyProvider
@inject FHIRBridge.LicenseServer.Data.LicenseServerDbContext Db
@{
    string NavClass(string path) =>
        string.Equals(Context.Request.Path.Value?.TrimEnd('/'), path.TrimEnd('/'), StringComparison.OrdinalIgnoreCase)
            ? "active" : "";

    // Only queried when there's an authenticated session to show the nav for at all — matches the
    // condition the nav bar itself is already wrapped in below.
    var pendingRequestCount = User.Identity?.IsAuthenticated == true
        ? await Db.LicenseRequests.CountAsync(r => r.FulfilledAtUtc == null)
        : 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - FHIRBridge License Server</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230f6e5f'/%3E%3Ctext x='16' y='22' font-size='17' font-family='Segoe UI,Arial,sans-serif' font-weight='700' fill='white' text-anchor='middle'%3EL%3C/text%3E%3C/svg%3E" />
</head>
<body>
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" href="/">FHIRBridge License Server</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <nav class="nav">
                    <a class="@NavClass("/")" href="/">Dashboard</a>
                    <a class="@NavClass("/LicenseRequests")" href="/LicenseRequests">
                        License Requests
                        @if (pendingRequestCount > 0)
                        {
                            <span class="nav-badge">@pendingRequestCount</span>
                        }
                    </a>
                    <a class="@NavClass("/Licenses/Create")" href="/Licenses/Create">Mint License</a>
                    <a class="@NavClass("/Licenses")" href="/Licenses">Issued Licenses</a>
                    <a class="@NavClass("/Guide")" href="/Guide">Guide</a>
                </nav>
                <form method="post" action="/Account/Logout" class="logout-form">
                    <button type="submit" class="link-button">Log out (@User.Identity!.Name)</button>
                </form>
            }
        </div>
    </header>

    @if (KeyProvider.IsUsingDevKey)
    {
        <div class="dev-key-banner">
            DEV SIGNING KEY ACTIVE — no production PFX configured. Licenses minted right now will NOT
            verify against a real deployed FHIRBridge instance's embedded production public key.
        </div>
    }

    <main class="content">
        @RenderBody()
    </main>
</body>
</html>
