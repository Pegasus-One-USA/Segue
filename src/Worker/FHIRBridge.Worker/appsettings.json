{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RuntimeWorker": {
    "IntervalSeconds": 300
  },
  "ScheduleDispatcher": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "HeartbeatLoggingEnabled": true
  },
  "ErrorCapture": {
    "Sinks": "Table",
    "MinimumRetentionDays": 180,
    "ApplicationInsights": { "ConnectionString": "", "IncludeCorrelationTimeline": true },
    "Ambient": {
      "Enabled": true,
      "CaptureProcessLevelExceptions": true,
      "CaptureLoggedErrors": true,
      "CaptureLogErrorsWithoutException": false,
      "DedupeWindowSeconds": 3,
      "RepeatSuppressionSeconds": 30
    }
  },
  "Observability": {
    "SeqServerUrl": "",
    "LogFilePath": "logs/fhirbridge-worker-.log"
  },
  "DataProtection": {
    "ApplicationName": "FHIRBridge",
    "KeyRingPath": "",
    "KeyVaultKeyId": ""
  },
  "KeyVault": {
    "UseAzureKeyVault": false,
    "AllowConfigurationFallback": true,
    "VaultName": "",
    "SecretPrefix": "",
    "HealthProbe": {
      "KeyVaultName": "",
      "SecretName": ""
    }
  }
}
