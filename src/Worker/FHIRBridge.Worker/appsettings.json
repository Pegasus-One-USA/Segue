{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RuntimeWorker": {
    "IntervalSeconds": 300
  },
  "ScheduleDispatcher": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "HeartbeatLoggingEnabled": true
  },
  "Observability": {
    "LogFilePath": "logs/fhirbridge-worker-.log"
  },
  "DataProtection": {
    "ApplicationName": "FHIRBridge",
    "KeyRingPath": "",
    "KeyVaultKeyId": ""
  },
  "KeyVault": {
    "UseAzureKeyVault": false,
    "AllowConfigurationFallback": true,
    "VaultName": "",
    "SecretPrefix": "",
    "HealthProbe": {
      "KeyVaultName": "",
      "SecretName": ""
    }
  }
}
