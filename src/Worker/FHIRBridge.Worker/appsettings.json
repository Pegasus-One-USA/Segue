{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RuntimeWorker": {
    "Enabled": false,
    "IntervalSeconds": 300
  },
  "ScheduleDispatcher": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "HeartbeatLoggingEnabled": true
  },
  "Observability": {
    "LogFilePath": "logs/fhirbridge-worker-.log"
  }
}
