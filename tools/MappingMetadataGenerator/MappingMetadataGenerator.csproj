<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone catalog generator. Deliberately NOT part of FHIRBridge.sln so it never affects
    `dotnet build`/`dotnet test` or the architecture tests. Run it manually to (re)generate
    src/FHIRBridge.Application/Mapping/Catalog/fhir-r4-catalog.json from the Firely R4 model.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FHIRBridge.Tools.MappingMetadataGenerator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hl7.Fhir.R4" Version="6.2.0" />
    <PackageReference Include="Hl7.Fhir.Specification.Data.R4" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FHIRBridge.Domain\FHIRBridge.Domain.csproj" />
  </ItemGroup>

</Project>
