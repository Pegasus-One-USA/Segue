<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone proof-of-concept. Deliberately NOT part of FHIRBridge.sln so it never affects
    `dotnet build`/`dotnet test` or the architecture tests, and does not reference any existing
    FHIRBridge project. Demonstrates loading a code system into an embedded HAPI FHIR terminology
    server and querying it back via standard FHIR terminology operations ($lookup/$validate-code).

    See README.md in this folder for what this does and does not prove, and how to test it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FHIRBridge.Tools.TerminologyServerPoc</RootNamespace>
  </PropertyGroup>

</Project>
